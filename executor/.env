SLIPPAGE_V2_BPS=150
SLIPPAGE_V3_BPS=100
SLIPPAGE_V3_LARGE_BPS=50
SLIPPAGE_PUMP_GRAD_BPS=800
SLIPPAGE_PRE_GRAD_BPS=1000
TRADE_SIZE_SOL_PRE_GRAD=0.030

# Solo v3_large live — tutto il resto in dry run
SYSTEMS_ENABLED=
DRY_RUN_SYSTEMS=pump_grad,pre_grad,defi,v3,v3_midcap,v2,bnf,mirror

# Massimo posizioni aperte contemporaneamente
MAX_OPEN_POSITIONS=4

# Mirror bot: false = scrive segnali reali in mirror_signals.csv (abilitato 16/06)
