# Capitale per trade Solana (USDC — per v3/defi)
TRADE_SIZE_USDC=5

# Capitale per pump_grad in SOL (PumpSwap usa SOL, non USDC)
# 0.065 SOL ≈ $15 a ~$230/SOL
TRADE_SIZE_SOL_PUMP=0.030

# Blocca swap se price impact > soglia (%)
MAX_PRICE_IMPACT_PCT=5.0

# Slippage per sistema (basis points: 100 = 1%)
