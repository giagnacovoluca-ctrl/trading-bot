# Copia in .env e compila le chiavi necessarie

# ── Pexels API (stock video gratuiti, 200req/h) ──────────────────
# Registrati su https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── ElevenLabs API (TTS premium, opzionale) ──────────────────────
# Registrati su https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # Adam (voce italiana profonda)

# ── Configurazione output ─────────────────────────────────────────
OUTPUT_DIR=output
TEMP_DIR=temp
ASSETS_DIR=assets

# Host/IP pubblico usato esclusivamente dal server media temporaneo per Meta.
PUBLIC_MEDIA_HOST=your_public_host_or_ip
META_GRAPH_VERSION=v24.0
IG_USER_ID=your_instagram_business_user_id
IG_ACCESS_TOKEN=your_meta_access_token

# Notifiche operative opzionali
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
